{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GBFR Tool",
  "version": "0.1.0",
  "identifier": "com.gbfr.tool",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
